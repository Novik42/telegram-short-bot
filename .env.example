APP_ENV=development
DATABASE_URL=postgresql+asyncpg://margin_monitor:margin_monitor@postgres:5432/margin_monitor
LOG_LEVEL=INFO

BORROW_PROVIDER=html
FIXTURE_BORROW_FILE=fixtures/borrow_snapshots.json
FIXTURE_REPLAY_SPEED=60
BORROW_JSON_URL=
BORROW_HTML_URL=https://bbm.iflint.pro/
BORROW_JSON_HEADERS={}
BORROW_SYMBOL_FIELD=symbol
BORROW_AMOUNT_FIELD=borrow_usd
REPAY_AMOUNT_FIELD=repay_usd
BORROW_RATIO_FIELD=ratio
BORROW_TIMESTAMP_FIELD=timestamp
BORROW_ROW_SELECTOR=
BORROW_SYMBOL_SELECTOR=
BORROW_AMOUNT_SELECTOR=
REPAY_AMOUNT_SELECTOR=
BORROW_RATIO_SELECTOR=

COLLECTION_INTERVAL_SECONDS=30
COLLECTION_INTERVAL_MINUTES=5
BORROW_DATA_MAX_AGE_MINUTES=15
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
BINANCE_MAX_CONCURRENCY=5
BINANCE_EXCHANGE_INFO_CACHE_MINUTES=60
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Telegram integration starts in Stage 3. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=

# Fail-closed semi-automatic trading. Only Bybit Demo is accepted by the code.
TRADING_MODE=disabled
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api-demo.bybit.com
DEMO_LEVERAGE=5
DEMO_RISK_PERCENT=1
DEMO_MAX_OPEN_POSITIONS=1
DEMO_SIGNAL_MAX_AGE_SECONDS=180
DEMO_PROPOSAL_TTL_SECONDS=90
DEMO_MAX_PRICE_DEVIATION_PCT=1
DEMO_STOP_BUFFER_PCT=0.5
DEMO_MIN_STOP_DISTANCE_PCT=1
DEMO_MAX_STOP_DISTANCE_PCT=8

MIN_BORROW_DELTA_USD=100000
MIN_BORROW_DELTA_PCT=30
MIN_NET_BORROW_DELTA_USD=75000
MIN_PRICE_PUMP_1H_PCT=5
MIN_PRICE_PUMP_4H_PCT=10
MAX_FRESH_PUMP_DRAWDOWN_PCT=8
BOUNCE_AFTER_DUMP_4H_PCT=-10
MIN_VOLUME_SPIKE_RATIO=1.5
MIN_ANOMALY_SCORE=60
SAFE_REPAY_EPSILON_USD=100
REQUIRE_CONFIRMATION_SNAPSHOTS=2
ALERT_COOLDOWN_MINUTES=60
ALERT_RENOTIFY_SCORE_INCREASE=15
ALERT_RENOTIFY_BORROW_INCREASE_PCT=50

# Persistent pump watch and 5m reversal confirmation.
REVERSAL_WATCH_HOURS=6
REVERSAL_WARNING_DRAWDOWN_PCT=3
REVERSAL_CONFIRM_DRAWDOWN_PCT=5
REVERSAL_SUPPORT_LOOKBACK_CANDLES=4
REVERSAL_LOWER_HIGH_DROP_PCT=0.5
REVERSAL_TOP_ZONE_DEPTH_PCT=8

# Raw snapshots are still stored, but these large-cap symbols are hidden from
# STATUS and excluded from BOR alerts / pump watches. Comma-separated.
HIGH_CAP_EXCLUDED_SYMBOLS=AAVE,ADA,APT,AVAX,BCH,BNB,BTC,CRO,DOGE,DOT,ETC,ETH,HBAR,ICP,LINK,LTC,NEAR,PAXG,PEPE,POL,SHIB,SOL,SUI,TAO,TON,TRX,UNI,XLM,XRP
